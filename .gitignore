# Basic Python .gitignore
# Tip: for a more comprehensive .gitignore see GitHubs Python.gitignore
# > https://github.com/github/gitignore/blob/main/Python.gitignore

# --- Python project ignores ---
# Python-generated files
__pycache__/
*.py[oc]
*.py[cod]
*.py[codz]
*$py.class
*.pyo
*.pyd

# Packaging
build/
dist/
wheels/
*.egg-info
_version.py

# Environments
# For Python projects it is recommended to add .python-version, uv.lock, poetry.lock,
# pixi.lock to version control. Is your project a library or package?
# If so, you might want to ignore these files since the code is intended to run in
# multiple environments.
.venv
venv/
.pixi/
env/
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.pixi/*
!.pixi/config.toml

# Ruff stuff:
.ruff_cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# pytest: unit test / coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# Jupyter Notebook
.ipynb_checkpoints/

# --- Repo sepecific ignores ---
# Folders
tmp/